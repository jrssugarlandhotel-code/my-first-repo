# Copy this file to .env for LOCAL testing only.
# On Render (or any host), set DATABASE_URL as a real environment variable
# in the dashboard instead of uploading a .env file.

# Get this connection string from your Neon (or Supabase) project dashboard.
# It looks like:
# postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Render sets this automatically; only needed for local runs.
PORT=3000

# ---------------------------------------------------------------------
# Automatic client emails (optional). If these are left blank, the app
# still works fine -- it just skips sending emails and logs a warning.
#
# Uses Resend's HTTPS API (not SMTP) -- free hosts like Render block
# outbound SMTP ports on their free tier, so a plain SMTP setup (Gmail,
# etc.) fails with a connection timeout no matter what. Resend sends
# over normal HTTPS instead, so it isn't affected.
#
# 1. Sign up free at https://resend.com (no credit card needed)
# 2. Dashboard -> API Keys -> Create API Key -> paste it below
# 3. For quick testing, leave MAIL_FROM as the default
#    "onboarding@resend.dev" -- but Resend only lets that address send
#    to the email you signed up with. To actually email guests, go to
#    Resend -> Domains -> add your own domain, verify it (a few DNS
#    records), then set MAIL_FROM to an address on it, e.g.
#    "Sales Desk <sales@yourhotel.com>".
# ---------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=onboarding@resend.dev
HOTEL_NAME=Your Hotel Name

# How many days an inquiry can sit untouched (still status "Inquiry")
# before the app automatically emails the guest a follow-up reminder.
FOLLOWUP_DAYS=3
# Set to "false" to turn off the automatic follow-up sweep entirely
# (the immediate "we received your inquiry" email still sends).
FOLLOWUP_ENABLED=true
